#!/bin/sh
# Run the lochara CLI from a checkout (uv makes the environment on first use).
# Works through a symlink too (e.g. ln -s "$PWD/lochara" ~/.local/bin/lochara).
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
exec uv run --quiet --project "$(cd "$(dirname "$self")" && pwd)" lochara "$@"
